{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LLM Usage Overlay",
  "version": "0.1.3",
  "identifier": "io.github.nyakojiru.llmusageoverlay",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LLM Usage",
        "width": 300,
        "height": 220,
        "minWidth": 170,
        "minHeight": 60,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "nyakojiru",
    "windows": {
      "nsis": {
        "languages": ["English", "Spanish"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
